{
  "name": "@modernized/exifr",
  "version": "8.0.0",
  "description": "📷 The fastest and most versatile JavaScript EXIF reading library — modernized fork of exifr (TypeScript, Node 22+, ES2020+ browser targets).",
  "author": "modernized (https://github.com/modernized-js)",
  "contributors": [
    "Mike Kovarik (https://github.com/MikeKovarik) — original author of exifr"
  ],
  "license": "MIT",
  "keywords": [
    "exif",
    "jpg",
    "jpeg",
    "png",
    "heif",
    "heic",
    "avif",
    "tiff",
    "xmp",
    "gps",
    "icc",
    "iptc",
    "jfif",
    "metadata",
    "orientation",
    "makernote"
  ],
  "homepage": "https://github.com/modernized-js/exifr#readme",
  "bugs": "https://github.com/modernized-js/exifr/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/modernized-js/exifr.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/full.umd.js",
  "module": "./dist/full.esm.mjs",
  "types": "index.d.ts",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node ./test/run.mjs",
    "test-bundles": "node ./test/run.mjs --bundles",
    "test-full": "node ./test/run.mjs --full",
    "test-lite": "node ./test/run.mjs --lite",
    "test-mini": "node ./test/run.mjs --mini",
    "coverage": "node ./test/run.mjs --coverage",
    "dev": "rollup -c rollup.config.mjs -w",
    "build-mini": "rollup -c rollup.config.mjs mini",
    "build-lite": "rollup -c rollup.config.mjs lite",
    "build-full": "rollup -c rollup.config.mjs full",
    "build": "rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prerelease": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.17.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rollup": "^4.60.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {}
}
